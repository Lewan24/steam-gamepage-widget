  "narrative": {
    "northStar": "The Quiet Game Workbench",
    "overview": "The implemented Operate direction is a calm, light tool surrounding expressive Steam artwork. Compact settings and restrained blue controls keep the editor precise; the card is the visual focal point. The editor stays light while the embedded card carries its own theme, accent, layout and corner radius.\n\nThis working metaphor and the descriptive color names document the implemented direction; they are not additional user-confirmed brand commitments. Source evidence: `src/styles.css` and `src/config.ts`. Browser screenshot verification was unavailable because the browser host could not be reached.",
    "keyCharacteristics": [
      "Light, bordered editor surfaces with compact settings.",
      "Artwork-led cards with independent theme and accent controls.",
      "Blue editor actions and a lime CTA on the default Midnight card.",
      "Explicit focus treatments and restrained motion."
    ],
    "rules": [
      {
        "name": "The Independent Accent Rule",
        "body": "Changing a card accent must not recolor the editor's blue controls.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do keep blue editor actions independent of the card's configurable accent.",
      "Do preserve each card theme's foreground, muted text and dividers as a set.",
      "Do retain visible keyboard focus and reduced-motion handling."
    ],
    "donts": [
      "Don't spread the preview drop shadow across flat editor panels.",
      "Don't force editor panel corners onto a user-configured card.",
      "Don't hard-code a single CTA foreground for every custom accent."
    ]
  }
