{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "steam-gamepage-widget",
  "compatibility_date": "2026-11-10",
  "main": "cloudflare/worker.mjs",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
}
